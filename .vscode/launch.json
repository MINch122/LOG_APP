{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "cFS Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/exe/cpu1/core-cpu1",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/exe/cpu1",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/sudo_gdb.sh",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]   
}