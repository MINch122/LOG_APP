{
  "app": "TO_LAB",
  "description": "Telemetry Output Lab app — enables telemetry downlink over UDP",
  "commands": [
    {
      "name": "Noop",
      "mid": "0x1880",
      "fc": 0,
      "description": "No-op command. Verifies command interface is alive.",
      "params": []
    },
    {
      "name": "Reset Status",
      "mid": "0x1880",
      "fc": 1,
      "description": "Reset housekeeping counters.",
      "params": []
    },
    {
      "name": "Add Packet",
      "mid": "0x1880",
      "fc": 2,
      "description": "Subscribe to a telemetry stream and add it to the output list.",
      "params": [
        {
          "name": "Stream",
          "type": "uint32",
          "default": "0",
          "description": "Message ID (stream) to subscribe to (e.g. 0x0800)"
        },
        {
          "name": "Flags",
          "type": "uint8",
          "default": "0",
          "description": "Packet flags (0 = default)"
        },
        {
          "name": "BufLimit",
          "type": "uint8",
          "default": "4",
          "description": "Software-bus subscription buffer limit"
        }
      ]
    },
    {
      "name": "Send Data Types",
      "mid": "0x1880",
      "fc": 3,
      "description": "Send the data-types telemetry packet (diagnostic).",
      "params": []
    },
    {
      "name": "Remove Packet",
      "mid": "0x1880",
      "fc": 4,
      "description": "Unsubscribe a single telemetry stream.",
      "params": [
        {
          "name": "Stream",
          "type": "uint32",
          "default": "0",
          "description": "Message ID (stream) to remove"
        }
      ]
    },
    {
      "name": "Remove All Packets",
      "mid": "0x1880",
      "fc": 5,
      "description": "Unsubscribe all telemetry streams.",
      "params": []
    },
    {
      "name": "Output Enable",
      "mid": "0x1880",
      "fc": 6,
      "description": "Enable telemetry output to a destination IP address.",
      "params": [
        {
          "name": "dest_IP",
          "type": "string",
          "length": 16,
          "default": "127.0.0.1",
          "description": "Destination IP address (null-terminated, max 16 bytes)"
        }
      ]
    }
  ]
}
