          "description": "Behavior when tagged time is exceeded. Skip, force or abord all pending commands."
        },
        {
          "name": "CommandSize",
          "type": "uint16",
          "default": "8",
          "description": "Size of the embedded command packet in bytes (min 8 for header only)"
