        {
          "name": "GroupId",
          "type": "uint16",
          "default": "0",
          "description": "Group identifier to query"
        }
      ]
    },
    {
      "name": "Query Group",
      "mid": "0x1890",
      "fc": 31,
      "description": "Query status of all entries in a group.",
      "params": [
        {
          "name": "GroupId",
          "type": "uint16",
          "default": "0",
