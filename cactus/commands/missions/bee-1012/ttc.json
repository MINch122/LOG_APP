          "name": "TimeTagType",
          "type": "enum",
          "storage": "uint8",
          "values": { "ABSOLUTE": 0, "RELATIVE": 1 },
          "default": "ABSOLUTE",
          "description": "Whether TimeTag is absolute (MET) or relative (from now)"
