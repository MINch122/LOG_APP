      "mid": "0x1890",
      "fc": 20,
      "description": "Begin a multi-packet command upload session (plumbing). Allocates a command slot.",
      "params": [
        {
          "name": "EntryId",
          "type": "uint16",
          "default": "0",
          "description": "Entry identifier for the plumbed command"
        },
        {
          "name": "GroupId",
          "type": "uint16",
          "default": "0",
          "description": "Group identifier for the plumbed command"
        }
      ]
    },
    {
      "name": "Plumb Write",
      "mid": "0x1890",
      "fc": 21,
      "description": "Write a chunk of data into the plumbing buffer at the given offset.",
      "params": [
        {
          "name": "EntryId",
          "type": "uint16",
          "default": "0",
          "description": "Entry identifier (must match Plumb Init)"
        },
        {
          "name": "GroupId",
          "type": "uint16",
          "default": "0",
          "description": "Group identifier (must match Plumb Init)"
        },
        {
          "name": "Offset",
          "type": "uint16",
          "default": "0",
