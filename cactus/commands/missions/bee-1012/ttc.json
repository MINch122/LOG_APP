      "mid": "0x1890",
      "fc": 22,
      "description": "Finalize a plumbing session — set time tag and schedule the assembled command.",
      "params": [
        {
          "name": "EntryId",
          "type": "uint16",
          "default": "0",
          "description": "Entry identifier (must match Plumb Init)"
