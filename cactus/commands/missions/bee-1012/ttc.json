        {
          "name": "GroupId",
          "type": "uint16",
          "default": "0",
          "description": "Group identifier (must match Plumb Init)"
        },
        {
          "name": "TimeTag",
          "type": "uint32",
          "default": "0",
          "description": "Execution time tag (absolute MET seconds or relative seconds)"
        },
        {
          "name": "StalenessThreshold",
          "type": "uint16",
          "default": "0",
          "description": "Max seconds past execution time before entry is dropped (0 = never)"
        },
        {
          "name": "CmdSize",
          "type": "uint16",
          "default": "0",
          "description": "Total size of the assembled command in bytes"
