    {
      "name": "Insert Relative Command Entry",
      "mid": "0x1890",
      "fc": 11,
      "description": "Schedule a command to execute N seconds from now (relative time).",
      "params": [
        {
          "name": "ExecutionTimeRelative",
          "type": "uint16",
          "default": "10",
